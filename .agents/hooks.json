{
  "security-fail-closed-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "^(run_command|view_file|read_file|write_to_file|write_file|replace_file_content|multi_replace_file_content|edit_file|find_by_name|grep_search|list_dir)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/pre_tool_fail_closed.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "cross-session-continuity": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ./scripts/cross_session_hooks.py session-start",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 ./scripts/cross_session_hooks.py pre-invocation",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 ./scripts/cross_session_hooks.py stop",
        "timeout": 5
      }
    ]
  }
}
